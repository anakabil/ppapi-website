    // =====================================================================
    // KEGIATAN — webinar, pelatihan, seminar … (PPAPI.kegiatan, store-kegiatan.js)
    // Tempel blok ini di dalam "match /databases/{database}/documents { … }"
    // pada site/firestore.rules, SEBELUM aturan penutup "match /{document=**}".
    // Memakai fungsi bantu yang sudah ada: signedIn(), isOwner(), isAdmin(),
    // isActiveMember(), strMax().
    //
    // • events/{eid}                 dibaca siapa pun bila status 'terbit' (admin: semua);
    //                                ditulis admin. Peserta hanya boleh menambah/mengurangi
    //                                'terdaftar' tepat 1 bersamaan dengan dokumen pendaftarannya,
    //                                dan menaikkan 'sertSeq' tepat 1 saat menerbitkan sertifikatnya.
    // • …/private/ruang              tautan ruang daring: admin + peserta terdaftar.
    // • …/participants/{uid}         pendaftaran oleh pemilik akun sesuai akses kegiatan
    //                                ('semua' = semua akun yang masuk; 'aktif' = anggota Aktif).
    // • …/attendance/{uid}           daftar hadir oleh peserta terdaftar HANYA bila
    //                                request.time di antara hadirBuka (selesai − 30 menit) dan
    //                                hadirTutup (selesai + 3 jam); waktu = waktu server.
    // • …/assets/certificate         desain sertifikat (data URL ≤ 900 KB): admin menulis,
    //                                admin + peserta yang sudah hadir membaca.
    // • certificates/{nomor}         verifikasi publik per nomor (get saja; daftar: admin).
    //                                Dibuat peserta yang hadir, sekali, dengan nomor urut
    //                                kegiatan berikutnya; status dicabut/dipulihkan oleh admin.
    // Anggaran: setiap permintaan memakai ≤ 7 akses dokumen dan beberapa puluh ekspresi.
    // =====================================================================
    function evPath(eid) {
      return /databases/$(database)/documents/events/$(eid);
    }
    function partPath(eid, uid) {
      return /databases/$(database)/documents/events/$(eid)/participants/$(uid);
    }
    function attPath(eid, uid) {
      return /databases/$(database)/documents/events/$(eid)/attendance/$(uid);
    }
    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    function personName(n) {
      return n is string && n.size() >= 3 && n.size() <= 120;
    }

    function validEvent(d) {
      return d.keys().hasOnly([
               'judul', 'jenis', 'deskripsi', 'narasumber', 'mulaiAt', 'selesaiAt', 'hadirBuka', 'hadirTutup',
               'mode', 'lokasi', 'tautanDaftar', 'kuota', 'terdaftar', 'akses', 'sertifikat', 'kode', 'tahun',
               'sertSeq', 'status', 'flyer', 'createdAt', 'updatedAt', 'updatedBy'
             ])
          && d.get('flyer', false) is bool
          && d.judul is string && d.judul.size() >= 3 && d.judul.size() <= 200
          && d.jenis is string && d.jenis.size() <= 40
          && d.mode in ['Daring', 'Luring', 'Hybrid']
          && d.akses in ['semua', 'aktif']
          && d.status in ['draf', 'terbit']
          && d.mulaiAt is timestamp && d.selesaiAt is timestamp && d.selesaiAt > d.mulaiAt
          && d.hadirBuka == d.selesaiAt - duration.value(30, 'm')
          && d.hadirTutup == d.selesaiAt + duration.value(3, 'h')
          && d.kuota is int && d.kuota >= 0
          && d.terdaftar is int && d.terdaftar >= 0
          && d.sertSeq is int && d.sertSeq >= 0
          && d.sertifikat is bool
          && d.kode is string && d.kode.matches('^[A-Z0-9]{2,12}$')
          && d.tahun is int && d.tahun >= 2020 && d.tahun <= 2100
          && strMax(d.deskripsi, 4000) && strMax(d.narasumber, 300) && strMax(d.lokasi, 300)
          && (d.tautanDaftar == '' || (d.tautanDaftar is string && d.tautanDaftar.size() <= 500
                                       && d.tautanDaftar.matches('^https://[^ ]+$')))
          && d.updatedAt == request.time && d.updatedBy == request.auth.uid;
    }

    // Peserta mengambil satu kursi: 'terdaftar' +1 (tidak melewati kuota) bersamaan dengan
    // pembuatan dokumen pendaftarannya sendiri.
    function seatTaken(eid) {
      return signedIn() && onlyChanged(['terdaftar'])
          && request.resource.data.terdaftar == resource.data.terdaftar + 1
          && (resource.data.kuota == 0 || request.resource.data.terdaftar <= resource.data.kuota)
          && !exists(partPath(eid, request.auth.uid))
          && existsAfter(partPath(eid, request.auth.uid));
    }
    // Peserta membatalkan: 'terdaftar' −1 bersamaan dengan penghapusan pendaftarannya.
    function seatReleased(eid) {
      return signedIn() && onlyChanged(['terdaftar'])
          && request.resource.data.terdaftar == resource.data.terdaftar - 1
          && exists(partPath(eid, request.auth.uid))
          && !existsAfter(partPath(eid, request.auth.uid));
    }
    // Peserta yang hadir mengambil nomor sertifikat berikutnya (sekali saja).
    function certNumbered(eid) {
      return signedIn() && onlyChanged(['sertSeq'])
          && resource.data.sertifikat == true
          && request.resource.data.sertSeq == resource.data.sertSeq + 1
          && exists(attPath(eid, request.auth.uid))
          && !('sertNo' in get(attPath(eid, request.auth.uid)).data)
          && getAfter(attPath(eid, request.auth.uid)).data.get('sertNo', '') != '';
    }

    function canJoin(eid) {
      let ev = get(evPath(eid)).data;
      return ev.status == 'terbit' && request.time < ev.selesaiAt
          && (ev.akses == 'semua' || isActiveMember() || isAdmin());
    }
    function validParticipant(d, uid) {
      return d.keys().hasOnly(['uid', 'nama', 'email', 'kta', 'statusAnggota', 'at'])
          && d.uid == uid && personName(d.nama)
          && strMax(d.email, 200) && strMax(d.kta, 24) && strMax(d.statusAnggota, 40)
          && d.at == request.time;
    }
    // Daftar hadir mandiri: terdaftar + dalam jendela waktu (waktu server).
    function attendOk(eid, uid, d) {
      let ev = get(evPath(eid)).data;
      return d.keys().hasOnly(['uid', 'nama', 'at'])
          && d.uid == uid && d.at == request.time
          && ev.status == 'terbit'
          && request.time >= ev.hadirBuka && request.time <= ev.hadirTutup
          && d.nama == get(partPath(eid, uid)).data.nama;
    }
    function validDesign(d) {
      return d.keys().hasOnly(['bg', 'bgW', 'bgH', 'orient', 'fields', 'updatedAt', 'updatedBy'])
          && (d.bg == '' || (d.bg is string && d.bg.size() <= 921600
                             && d.bg.matches('^data:image/(jpeg|png);base64,[A-Za-z0-9+/=]+$')))
          && d.bgW is int && d.bgH is int
          && d.orient in ['landscape', 'portrait']
          && d.fields is map && d.fields.size() <= 8
          && d.updatedAt == request.time && d.updatedBy == request.auth.uid;
    }
    // Flyer kegiatan: JPEG data URL ≤ 900 KB (dikompresi di peramban admin).
    function validFlyer(d) {
      return d.keys().hasOnly(['img', 'w', 'h', 'updatedAt', 'updatedBy'])
          && d.img is string && d.img.size() <= 921600
          && d.img.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
          && d.w is int && d.h is int
          && d.updatedAt == request.time && d.updatedBy == request.auth.uid;
    }
    // Sertifikat baru: nomor PPAPI-SERT-<tahun>-<kode>-<urut> milik peserta yang hadir.
    function certOk(no, d) {
      let eid = d.eventId;
      let ev = get(evPath(eid)).data;
      let a = get(attPath(eid, request.auth.uid)).data;
      let parts = no.split('-');
      return d.keys().hasOnly(['eventId', 'judul', 'jenis', 'tanggal', 'nama', 'tahun', 'kode', 'seq', 'terbit', 'status'])
          && eid is string
          && ev.status == 'terbit' && ev.sertifikat == true
          && !('sertNo' in a)
          && getAfter(attPath(eid, request.auth.uid)).data.get('sertNo', '') == no
          && d.nama == a.nama && d.judul == ev.judul && d.jenis == ev.jenis
          && d.kode == ev.kode && d.tahun == ev.tahun
          && d.seq == ev.sertSeq + 1
          && getAfter(evPath(eid)).data.sertSeq == d.seq
          && no.matches('^PPAPI-SERT-[0-9]{4}-[A-Z0-9]{2,12}-[0-9]{4,6}$')
          && parts[2] == string(ev.tahun) && parts[3] == ev.kode && int(parts[4]) == d.seq
          && strMax(d.tanggal, 80) && d.terbit == request.time && d.status == 'Sah';
    }

    match /events/{eid} {
      allow get, list: if resource.data.status == 'terbit' || isAdmin();
      allow create: if isAdmin() && validEvent(request.resource.data)
                    && request.resource.data.terdaftar == 0 && request.resource.data.sertSeq == 0
                    && request.resource.data.createdAt == request.time;
      allow update: if (isAdmin() && validEvent(request.resource.data))
                    || seatTaken(eid) || seatReleased(eid) || certNumbered(eid);
      allow delete: if isAdmin();

      match /private/{doc} {
        allow get: if isAdmin() || (signedIn() && exists(partPath(eid, request.auth.uid)));
        allow create, update: if isAdmin() && doc == 'ruang'
                              && request.resource.data.keys().hasOnly(['linkRuang', 'catatan', 'updatedAt'])
                              && strMax(request.resource.data.linkRuang, 500)
                              && strMax(request.resource.data.catatan, 500);
        allow delete: if isAdmin();
      }

      match /participants/{uid} {
        allow get: if isOwner(uid) || isAdmin();
        allow list: if isAdmin();
        allow create: if isOwner(uid) && canJoin(eid)
                      && validParticipant(request.resource.data, uid)
                      && getAfter(evPath(eid)).data.terdaftar == get(evPath(eid)).data.terdaftar + 1;
        // nama pada sertifikat dapat dibetulkan sebelum daftar hadir diisi
        allow update: if (isOwner(uid) || isAdmin()) && onlyChanged(['nama'])
                      && personName(request.resource.data.nama)
                      && !exists(attPath(eid, uid));
        allow delete: if (isOwner(uid) && !exists(attPath(eid, uid))
                          && request.time < get(evPath(eid)).data.mulaiAt
                          && getAfter(evPath(eid)).data.terdaftar == get(evPath(eid)).data.terdaftar - 1)
                      || isAdmin();
      }

      match /attendance/{uid} {
        allow get: if isOwner(uid) || isAdmin();
        allow list: if isAdmin();
        allow create: if (isOwner(uid) && attendOk(eid, uid, request.resource.data))
                      || (isAdmin()
                          && request.resource.data.keys().hasOnly(['uid', 'nama', 'at', 'olehAdmin'])
                          && request.resource.data.uid == uid && request.resource.data.at == request.time
                          && exists(partPath(eid, uid)));
        // nomor sertifikat dicatat sekali, bersamaan dengan dokumen certificates/{nomor}
        allow update: if isOwner(uid) && onlyChanged(['sertNo'])
                      && !('sertNo' in resource.data)
                      && request.resource.data.sertNo is string
                      && existsAfter(/databases/$(database)/documents/certificates/$(request.resource.data.sertNo))
                      && getAfter(evPath(eid)).data.sertSeq == get(evPath(eid)).data.sertSeq + 1;
        allow delete: if isAdmin();
      }

      match /assets/{doc} {
        // flyer: publik bila kegiatan terbit; desain sertifikat: admin + peserta yang hadir
        allow get: if isAdmin()
                   || (doc == 'flyer' && get(evPath(eid)).data.status == 'terbit')
                   || (doc == 'certificate' && signedIn() && exists(attPath(eid, request.auth.uid)));
        allow create, update: if isAdmin()
                              && ((doc == 'certificate' && validDesign(request.resource.data))
                                  || (doc == 'flyer' && validFlyer(request.resource.data)));
        allow delete: if isAdmin();
      }
    }

    match /certificates/{no} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if signedIn() && certOk(no, request.resource.data);
      allow update: if isAdmin() && onlyChanged(['status', 'alasan', 'dicabutAt'])
                    && request.resource.data.status in ['Sah', 'Dicabut']
                    && strMax(request.resource.data.get('alasan', ''), 300);
      allow delete: if false;
    }
