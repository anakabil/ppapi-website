rules_version = '2';

// ===========================================================================
// Aturan keamanan Firestore — situs PPAPI (versi 2: pendaftaran, admin,
// konten, Produk Pengetahuan; 21 Oktober 2026: instruktur, kegiatan &
// sertifikat, toko, data aplikasi anggota)
// Salin seluruh isi berkas ini ke Firebase Console › Firestore › Rules, lalu
// klik "Publish". (Lihat README.md bagian "Aturan Firestore v2".)
//
// PRINSIP: setiap pihak hanya mendapat akses seminimal mungkin.
// • members/{uid}      Anggota membaca & mengubah datanya sendiri, TETAPI hanya
//                      kolom profil + formulir pendaftaran. Status hanya dapat
//                      diubah anggota untuk: mengajukan formulir, menarik
//                      pengajuan, atau mengajukan perpanjangan. Kolom yang
//                      ditetapkan sekretariat (kta, kategori, masa berlaku,
//                      persetujuan, catatan sekretariat, tanggal bergabung)
//                      tidak dapat diubah anggota. Selama pengajuan "Menunggu
//                      Verifikasi", data yang diperiksa sekretariat (nama, HP,
//                      foto, profil, kompetensi, sertifikat, formulir) terkunci.
//                      Kolom email hanya boleh berisi email akun yang sedang
//                      masuk DAN sudah terverifikasi (atau kosong). Waktu
//                      pengajuan/pembaruan ditetapkan server (request.time).
//                      Admin membaca/menulis semua.
// • member_photos/{uid} Pas foto pemohon (data URL JPEG), terpisah dari data
//                      anggota agar daftar anggota tetap ringan. Dibaca pemilik
//                      dan admin; diubah pemilik hanya saat formulir boleh diubah.
// • admins/{uid}       Daftar admin (sekretariat). Seseorang adalah admin bila
//                      dokumen admins/{uid}-nya ada. Admin PERTAMA dibuat manual
//                      di Firebase Console (README); berikutnya lewat Konsol Admin.
// • registry/{kta}     Daftar verifikasi publik: satu nomor KTA dibaca siapa pun;
//                      pencarian dibatasi maksimal 20 hasil per permintaan
//                      (tidak dapat diunduh sekaligus); ditulis admin.
// • content_*/{id}     Berita, pengumuman, agenda, produk pengetahuan, regulasi
//                      yang dikelola admin: dibaca siapa pun, ditulis admin.
// • pustaka_files/{id} Tautan berkas KHUSUS ANGGOTA: dibaca admin atau anggota
//                      berstatus Aktif (masa berlaku belum habis); ditulis admin.
// • feedback/{id}      Siapa pun boleh mengirim; hanya admin yang dapat membaca
//                      dan memperbarui status (tercatat atas nama admin yang
//                      mengubah); tidak ada yang dapat menghapus.
// • counters/{id}      Penghitung nomor KTA (hanya admin).
// • audit_log/{id}     Log aktivitas admin: hanya admin; tidak dapat diubah/dihapus.
//
// Tambahan 21 Oktober 2026 (rincian di awal tiap blok di bawah):
// • instructors, instructor_contacts, instructor_requests   Direktori Instruktur
// • events (+ private, participants, attendance, assets), certificates
//                      Kegiatan: pendaftaran, daftar hadir, sertifikat
// • products, product_media, product_files, entitlements, orders,
//   shop_settings, carts                                     Toko PPAPI
// • app_data/{uid}/…   Data aplikasi anggota (Perencanaan, Simulator)
// • Koleksi lain       Ditolak.
//
// Batasan yang tidak dapat diperiksa aturan: isi tiap butir daftar
// (pengalaman, dokumen, kompetensi, sertifikat); jumlahnya tetap dibatasi dan
// ukuran dokumen maksimal 1 MiB.
// ===========================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Fungsi bantu umum
    // ---------------------------------------------------------------------
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Admin = dokumen admins/{uid milik pengguna} ada.
    function isAdmin() {
      return signedIn()
          && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function optString(d, key, max) {
      return !(key in d) || d[key] == null || (d[key] is string && d[key].size() <= max);
    }

    // Teks (data lama) atau stempel waktu server (serverTimestamp).
    function optStringOrTime(d, key, max) {
      return optString(d, key, max) || d[key] is timestamp;
    }

    // Email akun yang sedang masuk dan sudah dibuktikan pemiliknya (tautan verifikasi
    // email, atau akun Google). Email yang belum diverifikasi tidak dianggap milik akun.
    function verifiedEmail(email) {
      return signedIn()
          && request.auth.token.get('email', '') != ''
          && request.auth.token.get('email_verified', false) == true
          && email == request.auth.token.email;
    }

    // Pas foto: data URL JPEG, maksimal ±120 KB.
    function jpegDataUrl(s) {
      return s is string && s.size() <= 164000
          && s.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$');
    }

    function emptyOrMissing(d, key) {
      return !(key in d) || d[key] == null || d[key] == '';
    }

    function isoDate(s) {
      return s is string && s.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // 'TAHUN-BULAN-TANGGAL' → timestamp (pukul 00.00 UTC pada tanggal tersebut)
    function dateTs(s) {
      let p = s.split('-');
      return timestamp.date(int(p[0]), int(p[1]), int(p[2]));
    }

    // Masa berlaku masih berjalan (validUntil kosong = tanpa batas, data lama v1).
    function validityOk(m) {
      return !('validUntil' in m) || m.validUntil == null || m.validUntil == ''
          || (isoDate(m.validUntil) && dateTs(m.validUntil) + duration.value(1, 'd') > request.time);
    }

    // Anggota berstatus Aktif dan masa berlakunya belum habis.
    function isActiveMember() {
      return signedIn()
          && exists(/databases/$(database)/documents/members/$(request.auth.uid))
          && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.status == 'Aktif'
          && validityOk(get(/databases/$(database)/documents/members/$(request.auth.uid)).data);
    }

    // ---------------------------------------------------------------------
    // members/{uid}
    // ---------------------------------------------------------------------
    // Catatan anggaran evaluasi (diverifikasi pada proyek nyata, 2026-10-15): Firestore
    // membatasi 1.000 ekspresi per permintaan. Karena itu, pada PEMBARUAN hanya bagian
    // dokumen yang BERUBAH yang divalidasi (affectedKeys), dan pemeriksaan teks memakai
    // get() + strMax (lebih hemat daripada rangkaian "in"/"[]"). Bagian yang tidak
    // berubah sudah tervalidasi saat ditulis sebelumnya.

    function strMax(v, max) {
      return v == null || v == '' || (v is string && v.size() <= max);
    }
    function strOrTime(v, max) {
      return strMax(v, max) || v is timestamp;
    }
    function listMax(v, max) {
      return v == null || (v is list && v.size() <= max);
    }

    // profile: hanya 12 kolom yang dipakai situs (sama dengan store.js), teks dibatasi panjangnya.
    function validProfile(p) {
      return p is map
          && p.keys().hasOnly([
               'birthPlace', 'birthDate', 'gender', 'city', 'province', 'address',
               'company', 'position', 'experienceYears', 'education', 'bio', 'linkedin'
             ])
          && strMax(p.get('birthPlace', ''), 300) && strMax(p.get('birthDate', ''), 300)
          && strMax(p.get('gender', ''), 300) && strMax(p.get('city', ''), 300)
          && strMax(p.get('province', ''), 300) && strMax(p.get('address', ''), 2000)
          && strMax(p.get('company', ''), 300) && strMax(p.get('position', ''), 300)
          && strMax(p.get('education', ''), 300) && strMax(p.get('bio', ''), 2000)
          && strMax(p.get('linkedin', ''), 300)
          && (p.get('experienceYears', null) == null
              || (p.experienceYears is int && p.experienceYears >= 0 && p.experienceYears <= 80));
    }

    function validPembayaran(p) {
      return p is map && p.size() <= 3
          && strMax(p.get('metode', ''), 60)
          && strMax(p.get('tanggal', ''), 10)
          && strMax(p.get('buktiUrl', ''), 1000);
    }
    function validPernyataan(p) {
      return p is map && p.size() <= 5
          && p.get('kodeEtik', false) is bool
          && p.get('kebenaranData', false) is bool
          && p.get('privasi', false) is bool
          && strMax(p.get('namaTerang', ''), 120)
          && strMax(p.get('tanggal', ''), 10);
    }

    // Formulir pendaftaran (application) — batas sama dengan store.js:
    // pengalaman ≤ 10, dokumen ≤ 12, catatan ≤ 1.000. Pas foto disimpan di
    // member_photos/{uid} (pasFotoAda = ada/tidak); pasFoto di sini hanya untuk data lama.
    function validApplication(a) {
      return a is map
          && a.keys().hasOnly([
               'type', 'kategori', 'submittedAt', 'updatedAt', 'pengalaman', 'dokumen',
               'pasFoto', 'pasFotoAda', 'pembayaran', 'pernyataan', 'catatan'
             ])
          && a.get('type', 'baru') in ['baru', 'perpanjangan']
          && a.get('kategori', '') in ['', 'Praktisi', 'Ahli', 'Kehormatan']
          && strOrTime(a.get('submittedAt', ''), 40)
          && strOrTime(a.get('updatedAt', ''), 40)
          && listMax(a.get('pengalaman', null), 10)
          && listMax(a.get('dokumen', null), 12)
          && (a.get('pasFoto', '') == '' || a.get('pasFoto', '') == null || jpegDataUrl(a.pasFoto))
          && a.get('pasFotoAda', false) is bool
          && validPembayaran(a.get('pembayaran', {}))
          && validPernyataan(a.get('pernyataan', {}))
          && strMax(a.get('catatan', ''), 1000);
    }

    // Bagian inti dokumen anggota (murah): kolom yang diizinkan, uid, kategori, status.
    function memberCore(d, uid) {
      return d.keys().hasOnly([
               'uid', 'name', 'email', 'phone', 'photoURL', 'kta', 'memberType', 'status',
               'joinedAt', 'validUntil', 'approvedAt', 'approvedBy', 'profile', 'competencies',
               'certificates', 'application', 'review', 'contoh', 'createdAt', 'updatedAt'
             ])
          && d.uid == uid
          && d.memberType in ['Praktisi', 'Ahli', 'Kehormatan']
          && d.status in ['Draf', 'Menunggu Verifikasi', 'Perlu Perbaikan', 'Aktif', 'Ditolak', 'Nonaktif'];
    }

    // Kolom teks & waktu (dipakai saat pembuatan dokumen dan penulisan oleh admin).
    function memberStrings(d) {
      return strMax(d.get('name', ''), 120)
          && strMax(d.get('email', ''), 200)
          && strMax(d.get('phone', ''), 24)
          && strMax(d.get('photoURL', ''), 1000)
          && strMax(d.get('kta', ''), 40)
          && strMax(d.get('joinedAt', ''), 32)
          && strMax(d.get('validUntil', ''), 10)
          && strMax(d.get('approvedAt', ''), 40)
          && strMax(d.get('approvedBy', ''), 128)
          && strOrTime(d.get('createdAt', ''), 40)
          && strOrTime(d.get('updatedAt', ''), 40)
          && (d.get('contoh', false) is bool);
    }

    // Validasi lengkap (pembuatan dokumen & penulisan admin): bagian yang ada saja.
    function validMember(d, uid) {
      return memberCore(d, uid)
          && memberStrings(d)
          && (!('profile' in d) || validProfile(d.profile))
          && listMax(d.get('competencies', null), 50)
          && listMax(d.get('certificates', null), 50)
          && (!('application' in d) || validApplication(d.application))
          && (!('review' in d) || d.review is map);
    }

    // Email/nomor HP pada data anggota baru harus sama dengan milik akun yang masuk
    // (atau kosong). Email hanya diterima bila sudah diverifikasi pemiliknya.
    function contactMatchesAccount(d) {
      return (d.get('email', '') == '' || d.get('email', '') == null || verifiedEmail(d.email))
          && (d.get('phone', '') == '' || d.get('phone', '') == null
                || ('phone_number' in request.auth.token && d.phone == request.auth.token.phone_number));
    }

    // Formulir sudah diajukan (application.submittedAt terisi: waktu server, atau teks data lama).
    function submitted(d) {
      return d.get('application', {}).get('submittedAt', '') is timestamp
          || d.get('application', {}).get('submittedAt', '') != '';
    }

    // Boleh mengajukan perpanjangan: Nonaktif, atau Aktif dengan masa berlaku yang
    // telah habis / berakhir dalam ±60 hari.
    function renewable(m) {
      return m.status == 'Nonaktif'
          || (m.status == 'Aktif' && isoDate(m.get('validUntil', ''))
              && dateTs(m.validUntil) <= request.time + duration.value(61, 'd'));
    }

    // Pengajuan lengkap: kategori yang boleh diajukan (Kehormatan hanya untuk perpanjangan
    // oleh pemegangnya), nama, ketiga pernyataan, dan nama terang.
    function completeSubmission(before, after) {
      let a = after.get('application', {});
      let p = a.get('pernyataan', {});
      let kategori = a.get('kategori', '');
      return (kategori in ['Praktisi', 'Ahli']
                || (kategori != '' && kategori == before.get('memberType', '')
                    && before.get('approvedAt', '') != ''))
          && after.get('name', '') is string && after.get('name', '').size() >= 3
          && p.get('kodeEtik', false) == true
          && p.get('kebenaranData', false) == true
          && p.get('privasi', false) == true
          && p.get('namaTerang', '') is string && p.get('namaTerang', '').size() >= 3;
    }

    // Perubahan status yang boleh dilakukan ANGGOTA sendiri:
    //   Draf | Perlu Perbaikan | Ditolak  → Menunggu Verifikasi   (mengajukan formulir lengkap)
    //   Aktif (habis/≤60 hari) | Nonaktif → Menunggu Verifikasi   (perpanjangan, lengkap)
    //   Menunggu Verifikasi              → Draf                   (menarik pengajuan)
    function ownerTransition(before, after) {
      return (before.status in ['Draf', 'Perlu Perbaikan', 'Ditolak']
                && after.status == 'Menunggu Verifikasi' && submitted(after)
                && completeSubmission(before, after))
          || (renewable(before) && after.status == 'Menunggu Verifikasi' && submitted(after)
                && after.get('application', {}).get('type', '') == 'perpanjangan'
                && completeSubmission(before, after))
          || (before.status == 'Menunggu Verifikasi' && after.status == 'Draf' && !submitted(after));
    }

    // Formulir boleh diubah anggota hanya saat belum/tidak sedang diverifikasi.
    function applicationEditable(before, after) {
      return before.status in ['Draf', 'Perlu Perbaikan', 'Ditolak']
          || renewable(before)
          || (before.status == 'Menunggu Verifikasi' && (after.status == 'Draf' || !submitted(before)));
    }

    // Kategori yang diajukan anggota: Praktisi atau Ahli. Kategori lain
    // (Kehormatan) hanya bila sama dengan kategori resmi anggota atau tidak berubah.
    function kategoriAllowed(after, before) {
      let k = after.get('application', {}).get('kategori', '');
      return k in ['', 'Praktisi', 'Ahli']
          || k == before.get('memberType', '')
          || k == before.get('application', {}).get('kategori', '');
    }

    // Waktu pada formulir yang ditulis anggota = waktu server (atau tidak berubah /
    // dikosongkan saat menarik pengajuan). Antrean verifikasi diurutkan menurut submittedAt.
    function appTimesOk(after, before) {
      let a = after.get('application', {});
      let b = before.get('application', {});
      return (a.get('updatedAt', '') == b.get('updatedAt', '') || a.get('updatedAt', '') == request.time)
          && (a.get('submittedAt', '') == b.get('submittedAt', '') || a.get('submittedAt', '') == ''
              || a.get('submittedAt', '') == request.time);
    }

    // Selama "Menunggu Verifikasi" (formulir sudah diajukan), data yang sedang diperiksa
    // sekretariat tidak berubah kecuali pengajuan ditarik (→ Draf).
    function reviewedDataKept(changed, before, after) {
      return before.status != 'Menunggu Verifikasi' || !submitted(before) || after.status == 'Draf'
          || !changed.hasAny(['name', 'phone', 'photoURL', 'profile', 'competencies', 'certificates']);
    }

    // Setelah pernah disetujui (approvedAt terisi), nama yang tercantum pada KTA tidak
    // diubah anggota sendiri (koreksi nama oleh sekretariat). Nama kosong boleh dilengkapi.
    function identityKept(after, before) {
      return before.get('approvedAt', '') == '' || before.get('approvedAt', '') == null
          || !(before.get('name', '') is string) || before.get('name', '').size() < 3
          || after.get('name', '') == before.get('name', '');
    }

    // Pembaruan oleh anggota: hanya kolom yang diizinkan; kolom sekretariat tetap; hanya
    // bagian yang berubah yang divalidasi (hemat anggaran evaluasi).
    function ownerUpdate(after, before, uid) {
      let changed = after.diff(before).affectedKeys();
      return changed.hasOnly([
               'name', 'email', 'phone', 'photoURL', 'profile', 'competencies',
               'certificates', 'application', 'status', 'updatedAt'
             ])
          && memberCore(after, uid)
          && (!changed.hasAny(['name']) || (strMax(after.get('name', ''), 120) && identityKept(after, before)))
          && (!changed.hasAny(['email']) || after.get('email', '') == '' || after.get('email', '') == null
                || verifiedEmail(after.email))
          && (!changed.hasAny(['phone']) || strMax(after.get('phone', ''), 24))
          && (!changed.hasAny(['photoURL']) || strMax(after.get('photoURL', ''), 1000))
          && (!changed.hasAny(['profile']) || validProfile(after.profile))
          && (!changed.hasAny(['competencies']) || listMax(after.get('competencies', null), 50))
          && (!changed.hasAny(['certificates']) || listMax(after.get('certificates', null), 50))
          && (!changed.hasAny(['application'])
                || (validApplication(after.application) && applicationEditable(before, after)
                    && kategoriAllowed(after, before) && appTimesOk(after, before)))
          && (!changed.hasAny(['updatedAt']) || after.updatedAt == request.time)
          && (!changed.hasAny(['status']) || ownerTransition(before, after))
          && reviewedDataKept(changed, before, after);
    }

    // Pembaruan oleh admin: bagian yang berubah divalidasi; kolom inti selalu diperiksa.
    function adminUpdate(after, before, uid) {
      let changed = after.diff(before).affectedKeys();
      return memberCore(after, uid)
          && memberStrings(after)
          && (!changed.hasAny(['profile']) || !('profile' in after) || validProfile(after.profile))
          && (!changed.hasAny(['competencies']) || listMax(after.get('competencies', null), 50))
          && (!changed.hasAny(['certificates']) || listMax(after.get('certificates', null), 50))
          && (!changed.hasAny(['application']) || !('application' in after) || validApplication(after.application))
          && (!changed.hasAny(['review']) || !('review' in after) || after.review is map);
    }

    match /members/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();

      // Akun baru: status "Draf", kategori awal "Praktisi", tanpa nomor KTA, tanpa
      // masa berlaku/persetujuan/catatan sekretariat, formulir belum diajukan.
      allow create: if (isOwner(uid)
                          && validMember(request.resource.data, uid)
                          && contactMatchesAccount(request.resource.data)
                          && request.resource.data.status == 'Draf'
                          && request.resource.data.memberType == 'Praktisi'
                          && request.resource.data.get('kta', '') == ''
                          && request.resource.data.get('validUntil', '') == ''
                          && request.resource.data.get('approvedAt', '') == ''
                          && request.resource.data.get('approvedBy', '') == ''
                          && !('contoh' in request.resource.data)
                          && request.resource.data.get('review', {}).get('note', '') == ''
                          && request.resource.data.get('review', {}).get('history', []).size() == 0
                          && !submitted(request.resource.data)
                          && request.resource.data.get('application', {}).get('kategori', '')
                               in ['', 'Praktisi', 'Ahli']
                          && isoDate(request.resource.data.joinedAt))
                    || (isAdmin() && validMember(request.resource.data, uid));

      allow update: if (isOwner(uid) && ownerUpdate(request.resource.data, resource.data, uid))
                    || (isAdmin() && adminUpdate(request.resource.data, resource.data, uid));

      // Penghapusan data anggota hanya oleh admin (atas permintaan pemilik data atau untuk
      // membersihkan akun uji). Anggota tidak dapat menghapus datanya sendiri dari situs.
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // member_photos/{uid} — pas foto pemohon { uid, data, updatedAt }
    // Terpisah dari members/{uid} sehingga daftar anggota di Konsol Admin tidak ikut
    // mengunduh foto setiap anggota. Pemilik hanya dapat mengubahnya selama formulir
    // boleh diubah (tidak saat "Menunggu Verifikasi").
    // ---------------------------------------------------------------------
    function photoEditable(uid) {
      let m = get(/databases/$(database)/documents/members/$(uid)).data;
      return m.status in ['Draf', 'Perlu Perbaikan', 'Ditolak']
          || renewable(m)
          || (m.status == 'Menunggu Verifikasi' && !submitted(m));
    }

    match /member_photos/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if false;
      allow create, update: if ((isOwner(uid) && photoEditable(uid)) || isAdmin())
                            && request.resource.data.keys().hasOnly(['uid', 'data', 'updatedAt'])
                            && request.resource.data.uid == uid
                            && jpegDataUrl(request.resource.data.data)
                            && request.resource.data.updatedAt == request.time;
      allow delete: if (isOwner(uid) && photoEditable(uid)) || isAdmin();
    }

    // ---------------------------------------------------------------------
    // admins/{uid} — peran admin (sekretariat)
    // ---------------------------------------------------------------------
    match /admins/{uid} {
      // Pengguna boleh memeriksa dokumen admin miliknya sendiri (untuk mengetahui perannya).
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isAdmin()
                            && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'addedAt', 'addedBy'])
                            && request.resource.data.uid == uid
                            && request.resource.data.addedBy == request.auth.uid;
      // Bootstrap ADMIN PERTAMA tanpa menyunting Firestore di konsol: pemilik akun dengan
      // email TERVERIFIKASI yang persis sama dengan alamat di bawah boleh membuat dokumen
      // admin untuk dirinya sendiri (sekali; dokumen tidak dapat dibuat ulang bila sudah ada).
      // Setelah admin pertama ada, klausul ini boleh dihapus atau alamatnya diganti.
      allow create: if isOwner(uid)
                    && verifiedEmail('ppapi.indonesia@gmail.com')
                    && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'addedAt', 'addedBy'])
                    && request.resource.data.uid == uid
                    && request.resource.data.email == 'ppapi.indonesia@gmail.com'
                    && request.resource.data.addedBy == 'bootstrap';
      // Konsol Admin mencegah penghapusan admin terakhir.
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // registry/{kta} — verifikasi publik (data terbatas saja)
    // Satu nomor KTA dapat dibaca siapa pun. Pencarian (nama, awal nomor) hanya boleh
    // meminta paling banyak 20 dokumen sekali jalan, sehingga daftar anggota tidak dapat
    // diunduh sekaligus (sesuai kebijakan privasi: publik hanya memeriksa data terbatas).
    // ---------------------------------------------------------------------
    match /registry/{kta} {
      allow get: if true;
      allow list: if request.query.limit <= 20;
      allow create, update: if isAdmin()
                            && request.resource.data.keys().hasOnly([
                                 'kta', 'nama', 'kategori', 'kompetensi', 'kota', 'berlakuHingga',
                                 'status', 'namaCari', 'namaKata', 'ktaNomor', 'updatedAt', 'contoh'
                               ])
                            && request.resource.data.kta == kta;
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // Konten yang dikelola admin (digabung dengan berkas assets/data/*.js)
    // ---------------------------------------------------------------------
    match /content_berita/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /content_pengumuman/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /content_agenda/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /content_pustaka/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /content_regulasi/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // pustaka_files/{id} — tautan berkas Produk Pengetahuan KHUSUS ANGGOTA
    // ---------------------------------------------------------------------
    match /pustaka_files/{id} {
      allow read: if isAdmin() || isActiveMember();
      allow create, update: if isAdmin()
                            && request.resource.data.keys().hasOnly(['url', 'updatedAt', 'updatedBy'])
                            && request.resource.data.url is string
                            && request.resource.data.url.size() <= 1000;
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // feedback/{id} — umpan balik pengunjung
    // ---------------------------------------------------------------------
    function validFeedback(d) {
      return d.keys().hasOnly([
               'kategori', 'nama', 'email', 'phone', 'subjek', 'pesan',
               'rating', 'anonim', 'uid', 'halaman', 'createdAt'
             ])
          && d.kategori in ['Kritik', 'Saran', 'Pertanyaan', 'Pengaduan', 'Apresiasi']
          && d.pesan is string && d.pesan.size() >= 10 && d.pesan.size() <= 4000
          && optString(d, 'nama', 120)
          && optString(d, 'email', 200)
          && optString(d, 'phone', 24)
          && optString(d, 'subjek', 200)
          && optString(d, 'halaman', 200)
          && (!('rating' in d) || d.rating == null || (d.rating is int && d.rating >= 1 && d.rating <= 5))
          && (!('anonim' in d) || d.anonim is bool)
          && (!('uid' in d) || d.uid == null || (signedIn() && d.uid == request.auth.uid))
          && d.createdAt == request.time;
    }

    match /feedback/{id} {
      allow create: if validFeedback(request.resource.data);
      allow read: if isAdmin();
      // Admin hanya mengubah status tindak lanjut dan catatan internal.
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'catatanAdmin', 'updatedAt', 'updatedBy'])
                    && (!('status' in request.resource.data)
                        || request.resource.data.status in ['Baru', 'Diproses', 'Selesai'])
                    && optString(request.resource.data, 'catatanAdmin', 2000)
                    && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // counters/{id} — penghitung nomor KTA (mis. counters/kta-2026)
    // ---------------------------------------------------------------------
    match /counters/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin()
                   && request.resource.data.keys().hasOnly(['value', 'updatedAt'])
                   && request.resource.data.value is int && request.resource.data.value >= 0;
    }

    // ---------------------------------------------------------------------
    // audit_log/{id} — log aktivitas admin (hanya ditambah, tidak diubah)
    // ---------------------------------------------------------------------
    match /audit_log/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin()
                    && request.resource.data.keys().hasOnly([
                         'at', 'by', 'byName', 'action', 'label', 'targetType', 'targetId', 'targetName', 'note'
                       ])
                    && request.resource.data.by == request.auth.uid;
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------------
    // DIREKTORI INSTRUKTUR (instruktur.html · Konsol Admin › Instruktur)
    // Memakai fungsi bantu umum di atas: signedIn(), isAdmin(),
    // strMax(), isoDate(). (jpegDataUrl() tidak dipakai: batas foto di sini 150 KB.)
    //
    // • instructors/{id}          Profil publik. Dibaca siapa pun HANYA bila
    //                             published == true (daftar publik wajib memakai
    //                             where('published','==',true)); admin membaca
    //                             semua dan menulis. Tidak memuat kontak pribadi.
    // • instructor_contacts/{id}  Email/telepon instruktur, akun anggota tertaut,
    //                             catatan internal — KHUSUS admin.
    // • instructor_requests/{id}  Permintaan instruktur dari mitra penyelenggara:
    //                             dibuat siapa pun (tervalidasi, status 'Baru',
    //                             waktu dari server); dibaca & diperbarui admin
    //                             (status + catatan saja); tidak dapat dihapus.
    // Anggaran evaluasi: tiap permintaan < 60 ekspresi (jauh di bawah 1.000).
    // ---------------------------------------------------------------------
    function validInstructor(d) {
      return d.keys().hasOnly([
               'nama', 'gelar', 'foto', 'kompetensi', 'sertifikasi', 'pengalamanTahun', 'wilayah',
               'bahasa', 'metode', 'materi', 'bio', 'kta', 'published', 'createdAt', 'updatedAt'
             ])
          && d.nama is string && d.nama.size() >= 3 && d.nama.size() <= 120
          && d.gelar is string && d.gelar.size() <= 120
          && d.published is bool
          // foto: '' atau data URL JPEG ±150 KB
          && (d.foto == '' || (d.foto is string && d.foto.size() <= 205000 && d.foto.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')))
          && d.kompetensi is list && d.kompetensi.size() >= 1 && d.kompetensi.size() <= 16
          && d.sertifikasi is list && d.sertifikasi.size() <= 10
          && d.wilayah is list && d.wilayah.size() >= 1 && d.wilayah.size() <= 39
          && d.bahasa is list && d.bahasa.size() <= 6
          && d.metode is list && d.metode.size() >= 1 && d.metode.size() <= 2
          && d.materi is list && d.materi.size() <= 10
          && d.bio is string && d.bio.size() <= 600
          && (d.kta == '' || (d.kta is string && d.kta.matches('^PPAPI-[0-9]{4}-[0-9]{6}$')))
          && (d.pengalamanTahun == null || (d.pengalamanTahun is int && d.pengalamanTahun >= 0 && d.pengalamanTahun <= 60))
          && d.updatedAt == request.time;
    }

    match /instructors/{id} {
      allow get, list: if resource.data.published == true || isAdmin();
      allow create: if isAdmin() && id.size() <= 80
                    && validInstructor(request.resource.data)
                    && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
                    && validInstructor(request.resource.data)
                    && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin();
    }

    match /instructor_contacts/{id} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin()
                            && request.resource.data.keys().hasOnly(['email', 'telepon', 'memberUid', 'catatan', 'updatedAt'])
                            && strMax(request.resource.data.get('email', ''), 200)
                            && strMax(request.resource.data.get('telepon', ''), 24)
                            && strMax(request.resource.data.get('memberUid', ''), 128)
                            && strMax(request.resource.data.get('catatan', ''), 1000);
    }

    function validInstructorRequest(d) {
      return d.keys().hasOnly([
               'organisasi', 'namaPic', 'email', 'telepon', 'topik', 'metode', 'lokasi', 'tanggal',
               'jumlahPeserta', 'catatan', 'instrukturId', 'instrukturNama', 'uid', 'status', 'createdAt'
             ])
          && d.organisasi is string && d.organisasi.size() >= 2 && d.organisasi.size() <= 160
          && d.namaPic is string && d.namaPic.size() >= 3 && d.namaPic.size() <= 120
          && d.email is string && d.email.size() <= 200 && d.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
          && d.telepon is string && d.telepon.size() >= 8 && d.telepon.size() <= 24
          && d.topik is string && d.topik.size() >= 3 && d.topik.size() <= 200
          && d.metode in ['Luring', 'Daring', 'Fleksibel']
          && strMax(d.get('lokasi', ''), 160)
          && isoDate(d.tanggal)
          && d.jumlahPeserta is int && d.jumlahPeserta >= 1 && d.jumlahPeserta <= 1000
          && strMax(d.get('catatan', ''), 2000)
          && strMax(d.get('instrukturId', ''), 80)
          && strMax(d.get('instrukturNama', ''), 120)
          && (d.get('uid', null) == null || (signedIn() && d.uid == request.auth.uid))
          && d.status == 'Baru'
          && d.createdAt == request.time;
    }

    match /instructor_requests/{id} {
      allow create: if id.size() <= 40 && validInstructorRequest(request.resource.data);
      allow read: if isAdmin();
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'catatanAdmin', 'updatedAt', 'updatedBy'])
                    && request.resource.data.status in ['Baru', 'Diproses', 'Selesai']
                    && strMax(request.resource.data.get('catatanAdmin', ''), 2000)
                    && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    // =====================================================================
    // KEGIATAN — webinar, pelatihan, seminar … (PPAPI.kegiatan, store-kegiatan.js)
    // Memakai fungsi bantu umum di atas: signedIn(), isOwner(), isAdmin(),
    // isActiveMember(), strMax().
    //
    // • events/{eid}                 dibaca siapa pun bila status 'terbit' (admin: semua);
    //                                ditulis admin. Peserta hanya boleh menambah/mengurangi
    //                                'terdaftar' tepat 1 bersamaan dengan dokumen pendaftarannya,
    //                                dan menaikkan 'sertSeq' tepat 1 saat menerbitkan sertifikatnya.
    // • …/private/ruang              tautan ruang daring: admin + peserta terdaftar.
    // • …/participants/{uid}         pendaftaran oleh pemilik akun sesuai akses kegiatan
    //                                ('semua' = semua akun yang masuk; 'aktif' = anggota Aktif).
    // • …/attendance/{uid}           daftar hadir oleh peserta terdaftar HANYA bila
    //                                request.time di antara hadirBuka (selesai − 30 menit) dan
    //                                hadirTutup (selesai + 3 jam); waktu = waktu server.
    // • …/assets/certificate         desain sertifikat (data URL ≤ 900 KB): admin menulis,
    //                                admin + peserta yang sudah hadir membaca.
    // • certificates/{nomor}         verifikasi publik per nomor (get saja; daftar: admin).
    //                                Dibuat peserta yang hadir, sekali, dengan nomor urut
    //                                kegiatan berikutnya; status dicabut/dipulihkan oleh admin.
    // Anggaran: setiap permintaan memakai ≤ 7 akses dokumen dan beberapa puluh ekspresi.
    // =====================================================================
    function evPath(eid) {
      return /databases/$(database)/documents/events/$(eid);
    }
    function partPath(eid, uid) {
      return /databases/$(database)/documents/events/$(eid)/participants/$(uid);
    }
    function attPath(eid, uid) {
      return /databases/$(database)/documents/events/$(eid)/attendance/$(uid);
    }
    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    function personName(n) {
      return n is string && n.size() >= 3 && n.size() <= 120;
    }

    function validEvent(d) {
      return d.keys().hasOnly([
               'judul', 'jenis', 'deskripsi', 'narasumber', 'mulaiAt', 'selesaiAt', 'hadirBuka', 'hadirTutup',
               'mode', 'lokasi', 'tautanDaftar', 'kuota', 'terdaftar', 'akses', 'sertifikat', 'kode', 'tahun',
               'sertSeq', 'status', 'flyer', 'createdAt', 'updatedAt', 'updatedBy'
             ])
          && d.get('flyer', false) is bool
          && d.judul is string && d.judul.size() >= 3 && d.judul.size() <= 200
          && d.jenis is string && d.jenis.size() <= 40
          && d.mode in ['Daring', 'Luring', 'Hybrid']
          && d.akses in ['semua', 'aktif']
          && d.status in ['draf', 'terbit']
          && d.mulaiAt is timestamp && d.selesaiAt is timestamp && d.selesaiAt > d.mulaiAt
          && d.hadirBuka == d.selesaiAt - duration.value(30, 'm')
          && d.hadirTutup == d.selesaiAt + duration.value(3, 'h')
          && d.kuota is int && d.kuota >= 0
          && d.terdaftar is int && d.terdaftar >= 0
          && d.sertSeq is int && d.sertSeq >= 0
          && d.sertifikat is bool
          && d.kode is string && d.kode.matches('^[A-Z0-9]{2,12}$')
          && d.tahun is int && d.tahun >= 2020 && d.tahun <= 2100
          && strMax(d.deskripsi, 4000) && strMax(d.narasumber, 300) && strMax(d.lokasi, 300)
          && (d.tautanDaftar == '' || (d.tautanDaftar is string && d.tautanDaftar.size() <= 500
                                       && d.tautanDaftar.matches('^https://[^ ]+$')))
          && d.updatedAt == request.time && d.updatedBy == request.auth.uid;
    }

    // Peserta mengambil satu kursi: 'terdaftar' +1 (tidak melewati kuota) bersamaan dengan
    // pembuatan dokumen pendaftarannya sendiri.
    function seatTaken(eid) {
      return signedIn() && onlyChanged(['terdaftar'])
          && request.resource.data.terdaftar == resource.data.terdaftar + 1
          && (resource.data.kuota == 0 || request.resource.data.terdaftar <= resource.data.kuota)
          && !exists(partPath(eid, request.auth.uid))
          && existsAfter(partPath(eid, request.auth.uid));
    }
    // Peserta membatalkan: 'terdaftar' −1 bersamaan dengan penghapusan pendaftarannya.
    function seatReleased(eid) {
      return signedIn() && onlyChanged(['terdaftar'])
          && request.resource.data.terdaftar == resource.data.terdaftar - 1
          && exists(partPath(eid, request.auth.uid))
          && !existsAfter(partPath(eid, request.auth.uid));
    }
    // Peserta yang hadir mengambil nomor sertifikat berikutnya (sekali saja).
    function certNumbered(eid) {
      return signedIn() && onlyChanged(['sertSeq'])
          && resource.data.sertifikat == true
          && request.resource.data.sertSeq == resource.data.sertSeq + 1
          && exists(attPath(eid, request.auth.uid))
          && !('sertNo' in get(attPath(eid, request.auth.uid)).data)
          && getAfter(attPath(eid, request.auth.uid)).data.get('sertNo', '') != '';
    }

    function canJoin(eid) {
      let ev = get(evPath(eid)).data;
      return ev.status == 'terbit' && request.time < ev.selesaiAt
          && (ev.akses == 'semua' || isActiveMember() || isAdmin());
    }
    function validParticipant(d, uid) {
      return d.keys().hasOnly(['uid', 'nama', 'email', 'kta', 'statusAnggota', 'at'])
          && d.uid == uid && personName(d.nama)
          && strMax(d.email, 200) && strMax(d.kta, 24) && strMax(d.statusAnggota, 40)
          && d.at == request.time;
    }
    // Daftar hadir mandiri: terdaftar + dalam jendela waktu (waktu server).
    function attendOk(eid, uid, d) {
      let ev = get(evPath(eid)).data;
      return d.keys().hasOnly(['uid', 'nama', 'at'])
          && d.uid == uid && d.at == request.time
          && ev.status == 'terbit'
          && request.time >= ev.hadirBuka && request.time <= ev.hadirTutup
          && d.nama == get(partPath(eid, uid)).data.nama;
    }
    function validDesign(d) {
      return d.keys().hasOnly(['bg', 'bgW', 'bgH', 'orient', 'fields', 'updatedAt', 'updatedBy'])
          && (d.bg == '' || (d.bg is string && d.bg.size() <= 921600
                             && d.bg.matches('^data:image/(jpeg|png);base64,[A-Za-z0-9+/=]+$')))
          && d.bgW is int && d.bgH is int
          && d.orient in ['landscape', 'portrait']
          && d.fields is map && d.fields.size() <= 8
          && d.updatedAt == request.time && d.updatedBy == request.auth.uid;
    }
    // Flyer kegiatan: JPEG data URL ≤ 900 KB (dikompresi di peramban admin).
    function validFlyer(d) {
      return d.keys().hasOnly(['img', 'w', 'h', 'updatedAt', 'updatedBy'])
          && d.img is string && d.img.size() <= 921600
          && d.img.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
          && d.w is int && d.h is int
          && d.updatedAt == request.time && d.updatedBy == request.auth.uid;
    }
    // Sertifikat baru: nomor PPAPI-SERT-<tahun>-<kode>-<urut> milik peserta yang hadir.
    function certOk(no, d) {
      let eid = d.eventId;
      let ev = get(evPath(eid)).data;
      let a = get(attPath(eid, request.auth.uid)).data;
      let parts = no.split('-');
      return d.keys().hasOnly(['eventId', 'judul', 'jenis', 'tanggal', 'nama', 'tahun', 'kode', 'seq', 'terbit', 'status'])
          && eid is string
          && ev.status == 'terbit' && ev.sertifikat == true
          && !('sertNo' in a)
          && getAfter(attPath(eid, request.auth.uid)).data.get('sertNo', '') == no
          && d.nama == a.nama && d.judul == ev.judul && d.jenis == ev.jenis
          && d.kode == ev.kode && d.tahun == ev.tahun
          && d.seq == ev.sertSeq + 1
          && getAfter(evPath(eid)).data.sertSeq == d.seq
          && no.matches('^PPAPI-SERT-[0-9]{4}-[A-Z0-9]{2,12}-[0-9]{4,6}$')
          && parts[2] == string(ev.tahun) && parts[3] == ev.kode && int(parts[4]) == d.seq
          && strMax(d.tanggal, 80) && d.terbit == request.time && d.status == 'Sah';
    }

    match /events/{eid} {
      allow get, list: if resource.data.status == 'terbit' || isAdmin();
      allow create: if isAdmin() && validEvent(request.resource.data)
                    && request.resource.data.terdaftar == 0 && request.resource.data.sertSeq == 0
                    && request.resource.data.createdAt == request.time;
      allow update: if (isAdmin() && validEvent(request.resource.data))
                    || seatTaken(eid) || seatReleased(eid) || certNumbered(eid);
      allow delete: if isAdmin();

      match /private/{doc} {
        allow get: if isAdmin() || (signedIn() && exists(partPath(eid, request.auth.uid)));
        allow create, update: if isAdmin() && doc == 'ruang'
                              && request.resource.data.keys().hasOnly(['linkRuang', 'catatan', 'updatedAt'])
                              && strMax(request.resource.data.linkRuang, 500)
                              && strMax(request.resource.data.catatan, 500);
        allow delete: if isAdmin();
      }

      match /participants/{uid} {
        allow get: if isOwner(uid) || isAdmin();
        allow list: if isAdmin();
        allow create: if isOwner(uid) && canJoin(eid)
                      && validParticipant(request.resource.data, uid)
                      && getAfter(evPath(eid)).data.terdaftar == get(evPath(eid)).data.terdaftar + 1;
        // nama pada sertifikat dapat dibetulkan sebelum daftar hadir diisi
        allow update: if (isOwner(uid) || isAdmin()) && onlyChanged(['nama'])
                      && personName(request.resource.data.nama)
                      && !exists(attPath(eid, uid));
        allow delete: if (isOwner(uid) && !exists(attPath(eid, uid))
                          && request.time < get(evPath(eid)).data.mulaiAt
                          && getAfter(evPath(eid)).data.terdaftar == get(evPath(eid)).data.terdaftar - 1)
                      || isAdmin();
      }

      match /attendance/{uid} {
        allow get: if isOwner(uid) || isAdmin();
        allow list: if isAdmin();
        allow create: if (isOwner(uid) && attendOk(eid, uid, request.resource.data))
                      || (isAdmin()
                          && request.resource.data.keys().hasOnly(['uid', 'nama', 'at', 'olehAdmin'])
                          && request.resource.data.uid == uid && request.resource.data.at == request.time
                          && exists(partPath(eid, uid)));
        // nomor sertifikat dicatat sekali, bersamaan dengan dokumen certificates/{nomor}
        allow update: if isOwner(uid) && onlyChanged(['sertNo'])
                      && !('sertNo' in resource.data)
                      && request.resource.data.sertNo is string
                      && existsAfter(/databases/$(database)/documents/certificates/$(request.resource.data.sertNo))
                      && getAfter(evPath(eid)).data.sertSeq == get(evPath(eid)).data.sertSeq + 1;
        allow delete: if isAdmin();
      }

      match /assets/{doc} {
        // flyer: publik bila kegiatan terbit; desain sertifikat: admin + peserta yang hadir
        allow get: if isAdmin()
                   || (doc == 'flyer' && get(evPath(eid)).data.status == 'terbit')
                   || (doc == 'certificate' && signedIn() && exists(attPath(eid, request.auth.uid)));
        allow create, update: if isAdmin()
                              && ((doc == 'certificate' && validDesign(request.resource.data))
                                  || (doc == 'flyer' && validFlyer(request.resource.data)));
        allow delete: if isAdmin();
      }
    }

    match /certificates/{no} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if signedIn() && certOk(no, request.resource.data);
      allow update: if isAdmin() && onlyChanged(['status', 'alasan', 'dicabutAt'])
                    && request.resource.data.status in ['Sah', 'Dicabut']
                    && strMax(request.resource.data.get('alasan', ''), 300);
      allow delete: if false;
    }

    // =====================================================================
    // TOKO PPAPI (toko.html · keranjang.html · pesanan.html · Konsol Admin › Toko)
    // Memakai fungsi bantu umum di atas: signedIn(), isOwner(uid), isAdmin(),
    // strMax(v, max), listMax(v, max).
    //
    // • products/{id}          Katalog: dibaca siapa pun bila aktif (kueri publik
    //                          wajib memakai where('aktif','==',true)); admin semua.
    // • product_media/{id}     Foto produk ukuran penuh (≤3 data URL JPEG): publik.
    // • product_files/{id}     Tautan PRIVAT soft file: hanya admin, atau pembeli
    //                          yang memiliki dokumen hak unduh entitlements/{uid}_{id}.
    //                          Satu exists() — hemat anggaran evaluasi.
    // • entitlements/{uid_id}  Hak unduh: ditulis admin saat mengonfirmasi
    //                          pembayaran; dibaca pemiliknya dan admin.
    // • orders/{no}            Pembeli membuat pesanan berstatus "Menunggu
    //                          Pembayaran" atas namanya sendiri; membaca pesanannya
    //                          (kueri where('uid','==',uid)); selama belum dibayar
    //                          hanya boleh MENAMBAH BUKTI BAYAR atau MEMBATALKAN.
    //                          Admin membaca & memperbarui semua; tidak ada hapus.
    // • shop_settings/main     Rekening & ongkos kirim: publik baca, admin tulis.
    // • carts/{uid}            Keranjang tersinkron milik akun itu sendiri.
    // Catatan: harga ditulis peramban pembeli; aturan tidak menghitung ulang
    // (akan memerlukan get() per butir). Konsol Admin membandingkan harga pesanan
    // dengan katalog sebelum pembayaran dikonfirmasi.
    // =====================================================================

    function tokoKategori(k) {
      return k in ['Suvenir', 'Pakaian', 'Aksesori', 'Klem & Komponen Perancah', 'Produk Pengetahuan'];
    }
    function tokoStatus(s) {
      return s in ['Menunggu Pembayaran', 'Menunggu Konfirmasi', 'Dibayar', 'Diproses',
                   'Dikirim', 'Selesai', 'Dibatalkan'];
    }
    function tokoUnpaid(s) {
      return s in ['Menunggu Pembayaran', 'Menunggu Konfirmasi'];
    }

    function validProduct(d) {
      return d.keys().hasOnly([
               'nama', 'kategori', 'kode', 'ringkasan', 'deskripsi', 'harga', 'hargaAnggota',
               'format', 'hargaCetak', 'hargaCetakAnggota', 'halaman', 'stok', 'varian', 'thumb',
               'fotoCount', 'berkasAda', 'aktif', 'unggulan', 'urutan', 'createdAt', 'updatedAt'
             ])
          && d.nama is string && d.nama.size() >= 3 && d.nama.size() <= 120
          && tokoKategori(d.kategori)
          && d.harga is int && d.harga >= 0
          && d.aktif is bool
          && strMax(d.get('deskripsi', ''), 4000)
          && strMax(d.get('thumb', ''), 60000)
          && listMax(d.get('varian', []), 2);
    }

    match /products/{id} {
      allow read: if resource.data.aktif == true || isAdmin();
      allow create, update: if isAdmin() && validProduct(request.resource.data);
      allow delete: if isAdmin();
    }

    match /product_media/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
                            && request.resource.data.keys().hasOnly(['foto', 'updatedAt'])
                            && request.resource.data.foto is list
                            && request.resource.data.foto.size() <= 3;
      allow delete: if isAdmin();
    }

    match /product_files/{id} {
      allow get: if signedIn()
                 && (exists(/databases/$(database)/documents/entitlements/$(request.auth.uid + '_' + id))
                     || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin()
                            && request.resource.data.keys().hasOnly(['url', 'updatedAt', 'updatedBy'])
                            && request.resource.data.url is string
                            && request.resource.data.url.size() <= 1000
                            && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /entitlements/{eid} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create, update: if isAdmin()
                            && request.resource.data.keys().hasOnly(['uid', 'productId', 'orderId', 'grantedAt', 'grantedBy'])
                            && eid == request.resource.data.uid + '_' + request.resource.data.productId
                            && request.resource.data.grantedBy == request.auth.uid;
      allow delete: if isAdmin();
    }

    function validNewOrder(d, id) {
      return d.keys().hasOnly([
               'id', 'uid', 'buyer', 'items', 'perluKirim', 'alamat', 'ringkasan', 'status',
               'hargaAnggota', 'catatan', 'riwayat', 'createdAt', 'updatedAt'
             ])
          && id.matches('^PSN-[0-9]{8}-[A-Z0-9]{5}$')
          && d.id == id
          && d.uid == request.auth.uid
          && d.status == 'Menunggu Pembayaran'
          && d.items is list && d.items.size() >= 1 && d.items.size() <= 30
          && d.ringkasan is map && d.ringkasan.total is int && d.ringkasan.total >= 0
          && d.buyer is map && d.perluKirim is bool
          && (d.alamat == null || d.alamat is map)
          && strMax(d.get('catatan', ''), 500)
          && listMax(d.riwayat, 40)
          && d.createdAt == request.time && d.updatedAt == request.time;
    }

    // Pembeli: kirim/perbarui bukti bayar, atau batalkan — hanya selama belum dibayar.
    function ownerOrderUpdate(after, before) {
      let changed = after.diff(before).affectedKeys();
      return tokoUnpaid(before.status)
          && after.updatedAt == request.time
          && listMax(after.riwayat, 40)
          && (
               (after.status == 'Menunggu Konfirmasi'
                && changed.hasOnly(['pembayaran', 'status', 'riwayat', 'updatedAt'])
                && after.pembayaran.keys().hasOnly(['buktiUrl', 'tanggal', 'jumlah', 'pengirim', 'catatan', 'dikirimAt'])
                && after.pembayaran.buktiUrl is string
                && after.pembayaran.buktiUrl.size() <= 1000
                && after.pembayaran.buktiUrl.matches('^https://.+')
                && after.pembayaran.jumlah is int && after.pembayaran.jumlah > 0
                && strMax(after.pembayaran.get('catatan', ''), 500))
            || (after.status == 'Dibatalkan'
                && changed.hasOnly(['status', 'riwayat', 'updatedAt', 'alasanBatal', 'dibatalkanOleh'])
                && after.dibatalkanOleh == 'pembeli'
                && strMax(after.get('alasanBatal', ''), 500))
          );
    }

    match /orders/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if signedIn() && validNewOrder(request.resource.data, id);
      allow update: if signedIn()
                    && ((resource.data.uid == request.auth.uid
                         && ownerOrderUpdate(request.resource.data, resource.data))
                        || (isAdmin()
                            && tokoStatus(request.resource.data.status)
                            && request.resource.data.uid == resource.data.uid
                            && request.resource.data.id == resource.data.id));
      allow delete: if false;
    }

    match /shop_settings/{id} {
      allow read: if true;
      allow write: if isAdmin() && id == 'main'
                   && request.resource.data.keys().hasOnly([
                        'rekening', 'ongkirMode', 'ongkirFlat', 'ongkirCatatan',
                        'catatanPembayaran', 'batasBayarJam', 'kontak', 'updatedAt'
                      ])
                   && listMax(request.resource.data.rekening, 3)
                   && request.resource.data.ongkirMode in ['konfirmasi', 'flat'];
    }

    match /carts/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
                            && request.resource.data.keys().hasOnly(['items', 'updatedAt'])
                            && request.resource.data.items is list
                            && request.resource.data.items.size() <= 30;
    }

    // ---------------------------------------------------------------------
    // DATA APLIKASI ANGGOTA (aplikasi/perencanaan · aplikasi/simulator — data melekat ke akun)
    // Memakai fungsi bantu umum di atas: isOwner(uid), isAdmin().
    //
    // app_data/{uid}/{coll}/{docId}
    //   coll ∈ perencanaan · perencanaan_media · simulator · simulator_media
    //   Dokumen: { v, meta, data, size, updatedAt, parent }   (assets/js/store-apps.js)
    //     data      teks JSON isi aplikasi, ≤ 800.000 karakter (klien membatasi
    //               800.000 BYTE, jadi selalu lolos; batas Firestore 1 MiB tetap berlaku)
    //     meta      peta datar ≤ 24 kunci (nama proyek, lokasi, tanggal, status …)
    //     size      byte `data` (angka), updatedAt (ms, angka), parent (id induk media)
    //   • Pemilik (uid = akun yang masuk) membaca, menulis, dan menghapus datanya sendiri.
    //     Tidak disyaratkan status Aktif: data inspeksi milik anggota tetap dapat
    //     diambil kembali walaupun keanggotaannya berakhir (gerbang aplikasi tetap
    //     mensyaratkan Aktif untuk MEMAKAI aplikasi).
    //   • Admin PPAPI boleh MEMBACA (dukungan teknis); tidak menulis/menghapus.
    //   • Pihak lain ditolak.
    //   Anggaran evaluasi: ±20 ekspresi per tulis (penulisan selalu set() utuh,
    //   tanpa get() tambahan; isAdmin() hanya dievaluasi bila bukan pemilik).
    //   Isi `data` tidak diperiksa aturan (milik anggota sendiri, bentuk bebas).
    // ---------------------------------------------------------------------
    function appDataColl(coll) {
      return coll in ['perencanaan', 'perencanaan_media', 'simulator', 'simulator_media'];
    }
    function appDataDoc(d) {
      return d.keys().hasOnly(['v', 'meta', 'data', 'size', 'updatedAt', 'parent'])
          && d.keys().hasAll(['data', 'updatedAt'])
          && d.data is string && d.data.size() <= 800000
          && d.updatedAt is number
          && d.get('size', 0) is number
          && d.get('meta', {}) is map && d.get('meta', {}).size() <= 24
          && d.get('parent', '') is string && d.get('parent', '').size() <= 120;
    }
    match /app_data/{uid}/{coll}/{docId} {
      allow get, list: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid) && appDataColl(coll)
                            && docId.size() <= 120
                            && appDataDoc(request.resource.data);
      allow delete: if isOwner(uid);
    }

    // ---------------------------------------------------------------------
    // Selain yang tercantum di atas: ditolak.
    // ---------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
